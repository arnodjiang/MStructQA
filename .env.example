# Copy to .env locally. Never commit real credentials.
OPENAI_API_KEY=replace-with-your-key
# Optional: your provider's OpenAI-compatible Responses API base URL.
OPENAI_BASE_URL=https://api.openai.com/v1
# Set a model supported by your provider with image input and JSON output.
OPENAI_MODEL=replace-with-your-model
# Optional Judge overrides. Blank values inherit the matching OPENAI_* setting.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
# Set MVISQA_FONT in your shell to a Unicode font available on your machine.

# Separate Token Router credentials for native Gemini generateContent evaluation.
TOKEN_ROUTER_API_KEY=replace-with-token-router-key
TOKEN_ROUTER_BASE_URL=https://api.tokenrouter.com/v1

# Optional Hugging Face dataset publishing token. Never commit real credentials.
HF_TOKEN=
